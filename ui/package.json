{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "lint": "eslint src tests playwright.config.mjs eslint.config.mjs vite.config.mjs --max-warnings=0",
    "watch": "vite build --watch",
    "test:stack": "node --test tests/stack.test.mjs",
    "test:e2e": "playwright test --workers=1",
    "build:dev": "NODE_ENV=development vite build --mode development --outDir dist-dev",
    "test:e2e:dev": "yarn build:dev && UI_DIST=dist-dev playwright test --workers=1"
  },
  "dependencies": {
    "@carbon/icons-vue": "10.141.0",
    "@carbon/vue": "3.0.32",
    "await-to-js": "3.0.0",
    "axios": "1.18.1",
    "carbon-components": "10.59.2",
    "sass": "1.101.0",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vite": "8.1.3",
    "vue-eslint-parser": "10.4.2"
  },
  "packageManager": "yarn@4.18.1"
}
