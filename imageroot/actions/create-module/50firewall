# Open DNS (port 53, TCP and UDP) in the node firewall. AdGuard Home answers
# only the networks in its access list; the initial list allows private
# networks only (see pypkg/AdGuardHome.template.yaml).

import os

import agent

agent.assert_exp(
    agent.add_public_service(os.environ["MODULE_ID"], ["53/tcp", "53/udp"]),
    "Firewall service configuration has failed",
)
