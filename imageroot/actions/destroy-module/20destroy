# Remove the Traefik route and close the DNS port

import os
import sys
import agent
import agent.tasks

# Find default traefik instance for current node
default_traefik_id = agent.resolve_agent_id('traefik@node')
if default_traefik_id is None:
    print("Default Traefik instance of this node not found", file=sys.stderr)
    sys.exit(2)

# Remove traefik route
response = agent.tasks.run(
    agent_id=default_traefik_id,
    action='delete-route',
    data={
        'instance': os.environ['MODULE_ID']
    },
)

# Check if traefik configuration has been successfull
agent.assert_exp(response['exit_code'] == 0)

agent.assert_exp(agent.remove_public_service(os.environ['MODULE_ID']), "Firewall service removal has failed")
